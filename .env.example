DISCORD_TOKEN=вставьте_токен_бота

# --- API новостей для сайта (см. API.md) ---
# Длинный случайный ключ, сайт передаёт его в заголовке Authorization: Bearer <ключ>.
# Сгенерировать: openssl rand -hex 32. Пусто — API выключено.
API_TOKEN=
# Сервер Discord, чьи новости показывает сайт. Если пусто — тот, где в /setup выбран «Канал новостей»
API_GUILD_ID=
# Необязательный ключ только для чтения GET /api/news (если пусто — новости читаются без ключа)
API_PUBLIC_READ_KEY=

# --- HTTPS (Caddy) ---
# Домен, указывающий на IP сервера. Без своего домена подойдёт <IP через дефисы>.sslip.io
API_DOMAIN=45-134-217-51.sslip.io
# Порт HTTPS. Итоговый адрес API: https://API_DOMAIN:API_HTTPS_PORT/api
API_HTTPS_PORT=47821

# --- Новости из Discord -> на сайт ---
# Адрес на сайте, куда бот отправляет новости, опубликованные кнопкой в Discord. Пусто — не отправлять.
SITE_WEBHOOK_URL=
# Секрет для подписи X-Kraken-Signature; такой же должен знать сайт
SITE_WEBHOOK_SECRET=
